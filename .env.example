# ============================================================
# Business AI OS — Environment Variables
# Copy to .env and fill in values. NEVER commit .env files.
# ============================================================

# --- Application ---
# Frontend (login/dashboard): 3000 · Backend API: 5000
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
# docker-compose overrides host secrets with its own env block

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://bao:changeme@localhost:5432/business_ai_os
DATABASE_SSL=false

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Authentication ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
SESSION_SECRET=replace-with-another-long-random-string

# --- Encryption (AI provider API keys at rest, AES-256-GCM) ---
# Any string ≥32 chars; server derives a 32-byte key via SHA-256. NEVER commit real values.
ENCRYPTION_KEY=replace-with-a-long-random-string-32+

# --- Object Storage (S3-compatible) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=business-ai-os
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# --- AI Provider ---
AI_PROVIDER=openai
AI_API_KEY=sk-replace-with-your-key
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536

# --- External Integrations ---
PRESENTON_API_URL=https://api.presenton.ai
PRESENTON_API_KEY=replace-if-available
SCRAPLINK_API_URL=https://api.scraplink.co
SCRAPLINK_API_KEY=replace-if-available
DIFFY_API_URL=https://api.diffy.ai
DIFFY_API_KEY=replace-if-available

# --- Lead Intelligence: search ---
# Leave unset to require seed domains/URLs on a research job instead of web search.
SEARCH_PROVIDER=
SEARCH_API_KEY=

# --- Lead Intelligence: crawler safety limits ---
CRAWLER_REQUEST_TIMEOUT=15000
CRAWLER_MAX_RESPONSE_SIZE=2000000
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_PAGES_PER_DOMAIN=10
CRAWLER_MAX_CONCURRENCY=4
CRAWLER_RATE_LIMIT_MS=1000
CRAWLER_USER_AGENT=BusinessAIOS/1.0 (+lead-intelligence)
CRAWLER_RESPECT_ROBOTS=true

# --- Lead Intelligence: per-job cost control ---
RESEARCH_MAX_COMPANIES=200
RESEARCH_MAX_QUERIES=8
RESEARCH_MAX_PAGES_PER_COMPANY=8
RESEARCH_MAX_AI_CALLS=500
RESEARCH_CACHE_TTL_SECONDS=86400

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- Logging ---
LOG_LEVEL=info
LOG_FORMAT=json
